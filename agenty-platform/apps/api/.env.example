# Agenty Platform API Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenty_dev
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agenty_dev

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here
ENCRYPTION_KEY=your-base64-encryption-key-here

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Agenty Platform API
VERSION=1.0.0

# Provider API Keys (for testing)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=...
ELEVENLABS_API_KEY=...
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=...
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Monitoring & Analytics
SENTRY_DSN=
ANALYTICS_ENABLED=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10