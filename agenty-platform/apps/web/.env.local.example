# Agenty Platform - Frontend Environment Configuration
# Copy this file to .env.local and configure for your environment

# ============================================
# Backend API Configuration
# ============================================

# API Base URL - Points to AI Voicei backend server
# This MUST match your environment:

# Standard localhost (most developers):
NEXT_PUBLIC_API_URL=http://localhost:7860

# WSL2 (Windows Subsystem for Linux):
# Find your WSL2 IP with: hostname -I
# Then uncomment and set your IP:
# NEXT_PUBLIC_API_URL=http://172.x.x.x:7860

# Docker/Container environments:
# NEXT_PUBLIC_API_URL=http://host.docker.internal:7860

# Network access (access from other devices on your network):
# Find your network IP with: ifconfig or ipconfig
# NEXT_PUBLIC_API_URL=http://192.168.x.x:7860

# Production:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ============================================
# Optional: Analytics & Monitoring
# ============================================

# Google Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://...

# ============================================
# Optional: Feature Flags
# ============================================

# Enable beta features
# NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# Enable debug mode
# NEXT_PUBLIC_DEBUG_MODE=false

# ============================================
# Notes
# ============================================

# 1. All variables MUST start with NEXT_PUBLIC_ to be accessible in the browser
# 2. After changing .env.local, restart the dev server (npm run dev)
# 3. NEVER commit .env.local to git (it's in .gitignore)
# 4. For WSL2 users: Your IP may change after reboot - check with: hostname -I
