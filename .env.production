# AI Voicei Production Environment Configuration

# Server Configuration
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080

# Google Gemini API (Required for voice processing)
# GOOGLE_API_KEY=  # Must be provided via environment injection/secret manager at deploy time

# Daily.co API (Optional - for WebRTC transport)
# DAILY_API_KEY=  # Must be provided via environment injection/secret manager at deploy time

# Session Configuration
SESSION_ID=prod-session-default

# Logging
LOG_LEVEL=info

# Security
ALLOWED_ORIGINS=https://aivoicei.com,https://www.aivoicei.com,https://*.aivoicei.com

# Performance
MAX_SESSIONS=100
SESSION_TIMEOUT=3600

# Database (Future use)
# DATABASE_URL=  # Must be provided via environment injection/secret manager at deploy time

# Monitoring
# SENTRY_DSN=  # Must be provided via environment injection/secret manager at deploy time

# Rate Limiting
REQUESTS_PER_MINUTE=60
REQUESTS_PER_HOUR=1000