# AI Voicei Production Environment Configuration

# Server Configuration
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080

# Google Gemini API (Required for voice processing)
GOOGLE_API_KEY=${GOOGLE_API_KEY}

# Daily.co API (Optional - for WebRTC transport)
DAILY_API_KEY=${DAILY_API_KEY}

# Session Configuration
SESSION_ID=prod-session-default

# Logging
LOG_LEVEL=info

# Security
ALLOWED_ORIGINS=https://aivoicei.com,https://www.aivoicei.com,https://*.aivoicei.com

# Performance
MAX_SESSIONS=100
SESSION_TIMEOUT=3600

# Database (Future use)
DATABASE_URL=${DATABASE_URL}

# Monitoring
SENTRY_DSN=${SENTRY_DSN}

# Rate Limiting
REQUESTS_PER_MINUTE=60
REQUESTS_PER_HOUR=1000